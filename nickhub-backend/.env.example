# Database (see README for recommended free-tier Postgres hosts)
DATABASE_URL="postgresql://user:password@localhost:5432/nickhub?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CLIENT_URL="http://localhost:5173"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Create these two recurring Prices in the Stripe Dashboard first, then paste their IDs here:
#   Monthly: $2.99 / month
#   Yearly:  $25.00 / year
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."
